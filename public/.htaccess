# Never serve dotfiles (.env, .git, ...) or backup copies.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(bak|old|orig|sql|zip)$">
  Require all denied
</FilesMatch>

Options -Indexes

# Hashed build files never change, so cache them for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
